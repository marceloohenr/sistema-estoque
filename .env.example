# Ambiente local.
POSTGRES_DB=sistema_estoque_dev
POSTGRES_USER=estoque_dev
POSTGRES_PASSWORD=estoque_local_dev

# Portas na máquina local.
FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_PORT=5432

# Ao executar o Vite fora do Docker, o backend fica acessível em localhost.
VITE_API_PROXY_TARGET=http://localhost:3000

# SESSION_SECRET: valor aleatório com pelo menos 32 caracteres.
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Use true apenas para criar as contas locais. Preencha os dados abaixo antes.
# Em produção, deixe false; use bootstrap-admin para uma instalação nova.
SEED_USERS=false
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_NAME=Operador de Estoque
SEED_OPERATOR_USERNAME=operador
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=
