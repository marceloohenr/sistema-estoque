# Configuração local para desenvolvimento. Estes valores não são segredos de produção.
POSTGRES_DB=sistema_estoque_dev
POSTGRES_USER=estoque_dev
POSTGRES_PASSWORD=estoque_local_dev

# Portas publicadas na máquina hospedeira.
FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_PORT=5432

# Ao executar o Vite fora do Docker, o backend fica acessível em localhost.
VITE_API_PROXY_TARGET=http://localhost:3000

# Segurança da sessão. Gere um valor aleatório de pelo menos 32 caracteres.
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Bootstrap apenas para o ambiente local. Configure as credenciais antes de usar.
# Em produção, mantenha SEED_USERS=false e crie o primeiro administrador por procedimento seguro.
SEED_USERS=false
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_NAME=Operador de Estoque
SEED_OPERATOR_USERNAME=operador
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_PASSWORD=
