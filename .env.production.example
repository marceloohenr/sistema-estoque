# Copie para .env.production e configure os caminhos dos arquivos de segredo,
# fora do Git. POSTGRES_INIT_USER é apenas para inicialização; a API usa APP_DB_USER.
POSTGRES_DB=sistema_estoque
POSTGRES_INIT_USER=sistema_estoque_setup
POSTGRES_PASSWORD_FILE=.secrets/postgres_setup_password
APP_DB_USER=estoque_app
APP_DB_PASSWORD_FILE=.secrets/app_database_password
DATABASE_URL_FILE=.secrets/database_url
SESSION_SECRET_FILE=.secrets/session_secret

# Origem HTTPS pública configurada no proxy reverso externo.
APP_ORIGIN=https://estoque.seudominio.com.br
TRUST_PROXY=true
FRONTEND_PORT=8080
